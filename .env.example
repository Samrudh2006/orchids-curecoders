# ============================================================
# CureCoders Environment Variables Template
# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
# NOTE: `.env` is gitignored. NEVER commit real secrets.
# ============================================================

# --- REQUIRED: PostgreSQL Database ---
# The main connection string used by Prisma (prisma/schema.prisma reads this).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public"

# Optional: A separate connection string for direct DB access if the
# serverless connection is pooled (e.g. Supabase/Neon). If not needed,
# set it equal to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public"

# --- REQUIRED: JWT Authentication ---
# Secret used to sign and verify JWTs. Use a long random string.
JWT_SECRET="change_me_to_a_long_random_secret"

# --- Frontend / OAuth ---
# Base URL of your backend API. For local dev leave empty (Vite proxies /api).
# For Vercel you can set it, or omit it to use the same origin.
VITE_API_URL=""

# Google OAuth Client ID (used for "Sign in with Google").
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# --- AI / LLM providers (optional) ---
VITE_GEMINI_API_KEY=""
GROQ_API_KEY=""
DEFAULT_AI_MODEL="llama-3.3-70b-versatile"
DEFAULT_AI_BASE_URL="https://api.groq.com/openai/v1"

# --- Optional integrars ---
TAVILY_API_KEY=""
SARVAM_API_KEY=""
